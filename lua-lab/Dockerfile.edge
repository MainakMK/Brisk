# Brisk edge image for LOCAL Lua-edge testing (Phase 4 Step 5). nginx.org official
# build + the FULL dynamic-module stack: NDK + lua-nginx-module (LuaJIT) +
# headers-more + ngx_brotli, all ABI-matched to the image's nginx version, plus the
# lua-resty-core/lrucache libs and the brisk-agent binary. Proves the agent's real
# Lua layer (cache rules + header transforms) runs on the nginx.org build.
# Build context = repo root. Not for production (edges are bare-metal via bootstrap.go).
FROM nginx:1.27-bookworm AS modbuild
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git wget ca-certificates \
      libpcre2-dev zlib1g-dev libssl-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN set -eux; \
    NGV="$(nginx -v 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"; \
    wget -q "https://nginx.org/download/nginx-${NGV}.tar.gz"; tar xzf "nginx-${NGV}.tar.gz"; \
    git clone --depth=1 https://github.com/openresty/luajit2.git; \
    make -C luajit2 -j"$(nproc)"; make -C luajit2 install PREFIX=/usr/local/luajit; \
    git clone --depth=1 https://github.com/vision5/ngx_devel_kit.git; \
    git clone --depth=1 https://github.com/openresty/lua-nginx-module.git; \
    git clone --depth=1 https://github.com/openresty/lua-resty-core.git; \
    git clone --depth=1 https://github.com/openresty/lua-resty-lrucache.git; \
    git clone --depth=1 https://github.com/openresty/headers-more-nginx-module.git; \
    git clone --depth=1 --recurse-submodules https://github.com/google/ngx_brotli.git; \
    cd ngx_brotli/deps/brotli && mkdir -p out && cd out && \
      cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCMAKE_C_FLAGS=-fPIC .. && \
      cmake --build . --config Release -j"$(nproc)"; \
    export LUAJIT_LIB=/usr/local/luajit/lib LUAJIT_INC=/usr/local/luajit/include/luajit-2.1; \
    cd "/src/nginx-${NGV}" && ./configure --with-compat \
      --add-dynamic-module=../ngx_devel_kit \
      --add-dynamic-module=../lua-nginx-module \
      --add-dynamic-module=../headers-more-nginx-module \
      --add-dynamic-module=../ngx_brotli && \
    make -j"$(nproc)" modules; \
    mkdir -p /out && cp objs/*.so /out/

FROM nginx:1.27-bookworm
COPY --from=modbuild /out/ndk_http_module.so /out/ngx_http_lua_module.so /etc/nginx/modules/
COPY --from=modbuild /out/ngx_http_headers_more_filter_module.so /etc/nginx/modules/
COPY --from=modbuild /out/ngx_http_brotli_filter_module.so /etc/nginx/modules/
COPY --from=modbuild /out/ngx_http_brotli_static_module.so /etc/nginx/modules/
COPY --from=modbuild /usr/local/luajit/lib/ /usr/local/luajit/lib/
COPY --from=modbuild /src/lua-resty-core/lib/ /usr/local/brisk-lua/
COPY --from=modbuild /src/lua-resty-lrucache/lib/ /usr/local/brisk-lua/
COPY brisk-agent/dist/brisk-agent-linux-amd64 /usr/local/bin/brisk-agent
COPY lua-lab/edge-entrypoint.sh /entrypoint.sh
RUN echo /usr/local/luajit/lib > /etc/ld.so.conf.d/luajit.conf && ldconfig \
 && chmod +x /usr/local/bin/brisk-agent /entrypoint.sh \
 && mkdir -p /var/cache/brisk /var/www/brisk-acme /etc/brisk/tls /etc/brisk/lua \
 && chown -R www-data:www-data /var/cache/brisk
ENTRYPOINT ["/entrypoint.sh"]
