# Brisk dashboard — DEV image (HMR). Source is bind-mounted by docker-compose;
# node_modules stays in the container (anonymous volume) so host/Linux deps don't clash.
FROM node:22-alpine
WORKDIR /app

# Install deps first for layer caching.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173
# --host so Vite binds 0.0.0.0 and HMR works from the host browser.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
