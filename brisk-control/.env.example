# Copy to .env and set real values. Compose reads this file automatically.
# Never commit the real .env (it is git-ignored).
DB_PASSWORD=change-me

# --- Bunny DNS (Phase 3 Step 1) ---
# Account API key from the Bunny dashboard -> Account (the "AccessKey").
# Leave empty to disable DNS integration. NEVER commit the real key.
BUNNY_API_KEY=
# Either set the numeric zone id directly (preferred, avoids a lookup)...
BUNNY_DNS_ZONE_ID=
# ...or the zone domain name to resolve to an id at startup (use a TEST zone,
# not the live mainakghosh.com).
BUNNY_DNS_ZONE=
# Default record name Brisk routes (e.g. "cdn"); used by later steps.
BRISK_CDN_RECORD=cdn
# TTL (seconds) for routing records — short so failover is fast (clamped 10..120).
# Step 4 lowers the floor to 10s; ~15s pairs with the health checker for ~30-35s failover.
BRISK_DNS_TTL=15
# Network-wide Smart-Record routing mode (Phase 3 Step 3): geographic | latency.
# geographic = nearest by coordinates (default); latency = nearest Bunny region.
# Per-server overrides live in the servers table (routing_override / routing_weight).
BRISK_DNS_ROUTING_MODE=geographic

# --- Health checking (Phase 3 Step 4 — fast failover) ---
# detection ≈ INTERVAL × FAIL_THRESHOLD (10s×2 ≈ 20s); failover ≈ detection + TTL.
# Set BRISK_DNS_TTL=15 above for ~30-35s typical end-to-end failover.
# Per-server overrides live in the servers table (POST /servers/{id}/health).
BRISK_HEALTH_ENABLED=true
BRISK_HEALTH_INTERVAL=10          # seconds between probes per edge
BRISK_HEALTH_TIMEOUT=3            # per-probe timeout (must be < interval)
BRISK_HEALTH_FAIL_THRESHOLD=2     # consecutive fails -> unhealthy (fail fast)
BRISK_HEALTH_RISE_THRESHOLD=3     # consecutive OK -> healthy (recover careful)
BRISK_HEALTH_PATH=/healthz        # probe path on the edge
BRISK_HEALTH_SCHEME=https         # https | http (http for local testing)
BRISK_HEALTH_PORT=0               # 0 = scheme default (443/80)
