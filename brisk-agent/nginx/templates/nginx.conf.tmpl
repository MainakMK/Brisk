# Generated by brisk-agent — DO NOT EDIT BY HAND.
# Edge: {{ .EdgeID }}
# Phase 1: HTTP+HTTPS caching, headers-more branding, HLS/video slice caching
# with per-slice coalescing + CORS, TLS 1.3/ECDSA (Step 4), Brotli+Gzip and
# kernel/Nginx tuning (Step 5).

# Dynamic modules — compiled by bootstrap, ABI-locked to the exact nginx version.
# These load cleanly on the nginx.org build; the Ubuntu DISTRO build is linked with
# -Wl,-Bsymbolic-functions, which segfaulted headers-more (Phase 3.7 Step 1), so
# Step 2 rebuilt the edges on nginx.org to restore Server: Brisk + Brotli + slice.
{{- if .LuaEnabled }}
# Lua programmable edge (Phase 4 Step 5): NDK + lua-nginx-module (ABI-locked dynamic
# modules on the nginx.org build, like the others). Loaded BEFORE headers-more so the
# Lua header filter runs AFTER it — the Lua override_cache_ttl Cache-Control wins over
# the static more_set_headers. Rendered only when the module is installed; edges
# without it (today's live fleet) get no Lua and stay byte-identical.
load_module /etc/nginx/modules/ndk_http_module.so;
load_module /etc/nginx/modules/ngx_http_lua_module.so;
{{- end }}
load_module /etc/nginx/modules/ngx_http_headers_more_filter_module.so;
load_module /etc/nginx/modules/ngx_http_brotli_filter_module.so;
load_module /etc/nginx/modules/ngx_http_brotli_static_module.so;
{{- if .GeoIPEnabled }}
# GeoIP (Phase 4 Step 6): resolve the client country (ISO code) for logs/analytics +
# WAF country rules. Rendered only when the ngx_http_geoip2 module + GeoLite2 DB are
# installed; edges without it use a "-" placeholder (byte-identical behavior).
load_module /etc/nginx/modules/ngx_http_geoip2_module.so;
{{- end }}

# Run workers as www-data — the cache dir (/var/cache/brisk) is www-data-owned, so
# without this the default worker user can't write the cache (open() ... Permission
# denied -> 500). bootstrap chowns the cache to match. (Carried from Step 1.)
user www-data;
worker_processes auto;
worker_rlimit_nofile 200000;

events {
    worker_connections 32768;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # ---- cache storage: NVMe disk + RAM key zone ----
    # Instant purge (Step 5) is done by the agent DELETING matching cache files
    # (see brisk-agent/purge) — reliable for open-source Nginx incl. sliced video,
    # and needs no extra module. After a file is unlinked the next request is a MISS.
    proxy_cache_path {{ .CacheDir }}
        levels=1:2
        keys_zone=brisk_cache:512m
        max_size={{ .CacheMaxSize }}
        inactive=7d
        use_temp_path=off;
{{- if .LuaEnabled }}

    # ---- Lua programmable edge (Phase 4 Step 5) ----
    # The Brisk Lua library lives in /etc/brisk/lua; lua-resty-core/lrucache in
    # /usr/local/brisk-lua (installed by the edge build). init_by_lua loads the FFI
    # fast path + the agent-rendered per-zone data (refreshed every reload). Per-zone
    # rewrite/header_filter hooks are wired in the server blocks (only zones with
    # cache rules / header transforms).
    lua_package_path "/usr/local/brisk-lua/?.lua;/etc/brisk/lua/?.lua;;";
    init_by_lua_file /etc/brisk/lua/init.lua;
    # Errors-only rate limiting (Phase 4 Step 6 Part 5): a per-edge shared counter
    # of 401/403 responses per client IP on login/OTP paths. nginx limit_req can't
    # count by response status (it runs pre-response), so the Lua log phase counts
    # and the access phase blocks. ~10m holds ~80k IP/path keys; per-edge, approximate.
    lua_shared_dict brisk_rl 10m;
{{- end }}

    # $host is included so the agent can aggregate stats per zone (Step 4).
    log_format brisk '$remote_addr $host $upstream_cache_status [$time_local] '
                     '"$request" $status $body_bytes_sent rt=$request_time';
    access_log /var/log/nginx/brisk.access.log brisk;

    # ---- structured JSON access log (Phase 4 Step 6): the real Logs pipeline ----
    # The agent tails brisk.requests.log + ships entries to the control plane (batched,
    # bounded, drop-oldest). $brisk_country comes from GeoIP when installed (Part 5),
    # else "-". rt/urt are quoted (urt can be empty/list); the agent parses them.
{{- if .GeoIPEnabled }}
    geoip2 /etc/brisk/geoip/GeoLite2-Country.mmdb {
        auto_reload 24h;
        $brisk_country source=$remote_addr country iso_code;
    }
{{- else }}
    map $remote_addr $brisk_country { default "-"; }
{{- end }}
    log_format brisk_json escape=json
        '{"ts":"$time_iso8601","ip":"$remote_addr","country":"$brisk_country",'
        '"method":"$request_method","host":"$host","path":"$uri","status":$status,'
        '"bytes":$body_bytes_sent,"cache":"$upstream_cache_status",'
        '"rt":"$request_time","urt":"$upstream_response_time","ref":"$http_referer",'
        '"ua":"$http_user_agent","rid":"$request_id"}';
    access_log /var/log/nginx/brisk.requests.log brisk_json;

    # ---- WordPress-aware cache bypass ----
    # Never cache a response tied to a logged-in / password-protected / commenter
    # session (those Set-Cookie sessions must hit origin). Static assets ignore
    # this (they strip Set-Cookie); only the dynamic HTML location consults it.
    map $http_cookie $brisk_no_cache {
        default 0;
        "~*wordpress_logged_in|wp-postpass|comment_author" 1;
    }
{{- if .NeedWebpMap }}

    # ---- Vary Cache by browser image support (Part 3) ----
    # Folded into proxy_cache_key for zones with WebP/AVIF vary on, so a browser that
    # accepts modern formats gets its own cached variant. AVIF wins when both are sent.
    map $http_accept $brisk_webp {
        default "";
        "~*image/avif" "/avif";
        "~*image/webp" "/webp";
    }
{{- end }}
{{- if .NeedDeviceMap }}

    # ---- Vary Cache by device class (Part 3): desktop vs mobile ----
    map $http_user_agent $brisk_device {
        default "/d";
        "~*(mobile|android|iphone|ipad|ipod|opera mini|blackberry|iemobile)" "/m";
    }
{{- end }}

    # ---- per-zone rate limiting (Phase 4 Step 4): limit_req shared-memory zones ----
    # One zone per configured rate limit (and per WordPress-preset /wp-login.php),
    # keyed per client IP (and path where key=ip_path). Counters are PER-EDGE
    # (per-datacenter, like Cloudflare) — approximate, not globally exact. limit_req
    # itself is applied in the matching per-zone location (server.tmpl); over-limit
    # requests get 429. No zones here => no rate limiting (off by default).
{{- range .RateLimitZones }}
    limit_req_zone {{ .Key }} zone={{ .Name }}:10m rate={{ .Rate }};
{{- end }}
    limit_req_status 429;
{{- if .EdgeProtect }}

    # ---- Edge self-protection (#4): per-IP connection + request ceilings ----
    # The INSTANT local brake. A single client IP that floods this edge is shed here in
    # milliseconds — 503 over the concurrent-connection cap, 429 over the request rate —
    # independent of the control plane (works even if the dashboard is down) and of #3's
    # slow DNS steering. Counters are per-edge + per client IP, so the low-volume
    # health-checker IP keeps its own budget and /healthz stays answerable (the existing
    # health probe still governs DNS rotation). Off by default => none of this renders.
    limit_conn_zone $binary_remote_addr zone=brisk_perip:10m;
    limit_conn_status 503;
{{- if .EdgeReqPerSecPerIP }}
    limit_req_zone $binary_remote_addr zone=brisk_edge:10m rate={{ .EdgeReqPerSecPerIP }}r/s;
{{- end }}
{{- end }}

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    aio threads;
    keepalive_timeout 65;
    keepalive_requests 10000;
    server_tokens off;

    # NOTE: open_file_cache is deliberately OFF. It caches open FDs of served files;
    # for proxy_cache objects that means a purged (unlinked) cache file keeps being
    # served from the cached FD for up to open_file_cache_valid (a stale HIT after a
    # purge — confirmed on the live fleet). Brisk proxies everything (no hot local
    # static files to optimize), so the cache buys ~nothing and breaks purge. Leave off.

    # ---- compression: Brotli (primary) + Gzip (fallback). TEXT ONLY. ----
    # Never compress images/video — already compressed; re-compressing wastes CPU.
    # comp_level 4-6 is the on-the-fly sweet spot; level 11 only for brotli_static.
    brotli on;
    brotli_static on;
    brotli_comp_level {{ .BrotliCompLevel }};
    brotli_min_length 256;
    brotli_buffers 16 8k;
    brotli_window 512k;
    brotli_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json font/ttf font/otf;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    # ---- request coalescing: one origin pull for simultaneous misses ----
    proxy_cache_lock on;
    proxy_cache_lock_age 5s;
    proxy_cache_lock_timeout 5s;

    # ---- resilience: serve stale on origin trouble + refresh in background ----
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_revalidate on;

    # ---- TLS (Mozilla Intermediate; common settings inherited by all servers) ----
    # No OCSP stapling and no custom dhparam (Step 4.3): no benefit with Let's
    # Encrypt / self-signed certs, and the profile is modern ECDHE-only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;          # let client pick (better ChaCha20 on mobile)
    ssl_session_cache shared:BriskTLS:50m;  # ~200k sessions, inherited by all zones
    ssl_session_timeout 1d;
    ssl_session_tickets {{ if .SessionTickets }}on{{ else }}off{{ end }};

    # ---- stub_status: connection/request counters for the agent (Step 4) ----
    # Bound to localhost only; the agent scrapes it for req/s + active conns.
    server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /brisk_status {
            stub_status;
            allow 127.0.0.1;
            deny all;
        }
    }
    # ---- default_server: catch unmatched Host (Phase 4 Step 1, multi-tenant) ----
    # A request whose Host matches no tenant zone must NOT fall through to a random
    # tenant's site (content-leak / wrong-site bug) -> it gets a clean 444.
    #
    # BUT: the control-plane health checker probes edges by IP (no SNI), so those
    # probes land HERE, not on a tenant block. We must still answer /healthz 200 or
    # every edge would be marked unhealthy and pulled from DNS. So the default_server
    # carries a cert (the managed wildcard; the checker uses InsecureSkipVerify, so
    # the name needn't match the IP) and serves /healthz; everything else -> 444.
    # NOTE: NOT ssl_reject_handshake — that would reject the no-SNI health probe.
    server {
{{- if .HTTP2On }}
        listen 443 ssl default_server;
        http2 on;
{{- else }}
        listen 443 ssl http2 default_server;
{{- end }}
        listen 80 default_server;
        server_name _;
        ssl_certificate     {{ .DefaultCertPath }};
        ssl_certificate_key {{ .DefaultKeyPath }};
{{- template "edgeprotect" . }}
{{- if .ACMEChallengeProxy }}
        # ACME HTTP-01 (Phase 4 Step 2): also answer the challenge on the catch-all,
        # so a CA request whose Host doesn't exactly match a tenant block (or hits
        # the edge by IP) still proxies to the control plane and validates.
        location ^~ /.well-known/acme-challenge/ {
            proxy_pass {{ .ACMEChallengeProxy }};
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
{{- end }}
        location = /healthz {
            access_log off;
            default_type "text/plain";
            return 200 "ok\n";
        }
        location / { return 444; }
    }
{{- range .ShieldUpstreams }}

    # ---- edge->shield keepalive pool (Hybrid Shield+PoP Build Spec, Layer 3) ----
    # Warm, POOLED connections to the shield PoP {{ .Server }} so a cache MISS reuses
    # an already-open connection instead of paying a fresh TCP+TLS handshake — the
    # PoP-to-PoP latency win. Rendered ONLY for zones that enable a shield; a
    # non-shielded fleet emits none, so the config stays byte-identical.
    upstream {{ .Name }} {
        server {{ .Server }};
        keepalive 32;
        keepalive_timeout 60s;
        keepalive_requests 1000;
    }
{{- end }}
{{ range .Zones }}
{{ template "server.tmpl" . }}{{ end }}
}
